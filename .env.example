# Set the real canonical origin before deploying, for example https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Optional public direct-contact email. Leave blank until a real business address is available.
NEXT_PUBLIC_CONTACT_EMAIL=
# Absolute HTTPS URL of the final, reviewed privacy notice. It must match PUBLISHED_PRIVACY_NOTICE_URL below.
NEXT_PUBLIC_PRIVACY_NOTICE_URL=

# Keep both delivery flags false/empty until email, Turnstile, and a reviewed privacy notice are ready.
NEXT_PUBLIC_INQUIRY_DELIVERY_ENABLED=false
INQUIRY_DELIVERY_ENABLED=false

# Cloudflare Turnstile widget keys (public site key + private server secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend email delivery (server-only secrets/configuration)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Absolute HTTPS URL of the final, reviewed privacy notice. Must exactly match NEXT_PUBLIC_PRIVACY_NOTICE_URL.
PUBLISHED_PRIVACY_NOTICE_URL=
